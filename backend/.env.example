# Groq API Key — get yours at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Name — defaults to openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b

# Groq Fallback Model Name — defaults to openai/gpt-oss-20b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# CORS Allowed Origins — comma-separated list of origins allowed to request the API.
# Default if unset is http://localhost:3000
CORS_ORIGINS=http://localhost:3000
